{
  "name": "team-site-template",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "bun run serve.ts",
    "publish": "bash ./publish.sh",
    "go-live": "bash ./go-live.sh",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "verify": "bun scripts/search-test.ts && bun scripts/verifyContractSnap.ts && bun scripts/verifyGaragesnap.ts && bun scripts/verifyHomesnap.ts && bun scripts/verifyReceiptsnap.ts && bun scripts/verifyBillsnap.ts && bun scripts/verifyBooksnap.ts && bun scripts/verifyMeetingsnap.ts && bun scripts/verifyAllAccess.ts && bun scripts/verifyWaitlist.ts",
    "test": "npm run build && npm run typecheck && npm run verify"
  },
  "dependencies": {
    "@clerk/tanstack-start": "^0.11.5",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-router": "^1.158.1",
    "@tanstack/react-start": "^1.158.3",
    "@tanstack/start-storage-context": "^1.167.15",
    "@uploadthing/react": "^7.3.3",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.35.3",
    "stripe": "^22.4.0",
    "tesseract.js": "^7.0.0",
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5"
  }
}
